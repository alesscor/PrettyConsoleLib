{
  "PrettyConsoleApp": {
    "Title": "Calculator"
  },
  "Logs": {
    "Directory": "logs",
    "Name": "app-.log"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs\\app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "PrettyConsoleApp"
    }
  }
}